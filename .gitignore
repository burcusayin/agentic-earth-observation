# Environment and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
dist/
build/
*.egg-info/
.DS_Store

# Scratch evaluation runs (reported runs are committed under results/runs/)
results/raw/
# Server logs of a run: a traceback in them carries paths of this machine
results/runs/**/*.log
# Output of a run left going overnight (`nohup uv run eo-agent eval ...`)
nohup.out

# Private, never committed: local notes and keys
.local/
CLAUDE.local.md
.env
.env.*
!.env.example
.envrc
.claude/settings.local.json
*.key
*.pem
secrets/
