# Copy to .env and adjust. .env is gitignored: never commit it.
# Read by the agents and the evaluation runner, which are not implemented yet.
# Secrets stay empty here.

# Model under test. Provider: ollama (local, free) or mistral (paid; evaluation runs only).
EO_LLM_PROVIDER=ollama
EO_LLM_MODEL=qwen3.5:9b
EO_OLLAMA_URL=http://127.0.0.1:11434
EO_MISTRAL_API_KEY=

# Catalogue and local services
EO_STAC_API_URL=https://earth-search.aws.element84.com/v1
EO_MCP_URL=http://127.0.0.1:8001/mcp
EO_A2A_URL=http://127.0.0.1:8002
