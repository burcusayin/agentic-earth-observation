# Copy to .env and adjust. .env is gitignored: never commit it.
# Every setting has a default (src/agentic_earth_observation/config.py), and an empty value means the default.
# A misspelt EO_ name is refused. Secrets stay empty here.

# Model under test. Provider: ollama (local, free) or mistral (paid; evaluation runs only).
EO_LLM_PROVIDER=ollama
EO_LLM_MODEL=qwen3.5:9b
EO_OLLAMA_URL=http://127.0.0.1:11434
EO_MISTRAL_API_KEY=

# Catalogue and local services
EO_STAC_API_URL=https://earth-search.aws.element84.com/v1
EO_MCP_URL=http://127.0.0.1:8001/mcp
EO_A2A_URL=http://127.0.0.1:8002

# Where the MCP server records every tool call (gitignored). A relative path starts at the repository root.
EO_TOOL_LOG=results/raw/tool_calls.jsonl
# The day the agents treat as today (YYYY-MM-DD). Empty: the real date in UTC.
EO_REFERENCE_DATE=

# Limits per retrieval turn: model calls, and tokens generated by one model call
EO_MAX_MODEL_CALLS=6
EO_NUM_PREDICT=1024

# Timeouts in seconds. They nest: one STAC request < STAC deadline (one tool call, retries included)
# < MCP < retrieval turn < A2A < harness; and one model call < retrieval turn.
EO_STAC_TIMEOUT_S=20
EO_STAC_MAX_RETRIES=3
EO_STAC_DEADLINE_S=90
EO_MODEL_TIMEOUT_S=120
EO_MCP_TIMEOUT_S=120
EO_TURN_DEADLINE_S=240
EO_A2A_TIMEOUT_S=300
EO_HARNESS_TIMEOUT_S=360
